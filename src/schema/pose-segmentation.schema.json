{
    "title": "Pose Segmentation Parameters",
    "description": "Parameters for pose segmentation algorithm.",
    "type": "object",
    "properties": {
        "n_clusters": {
            "type": "integer",
            "title": "Number of Clusters",
            "description": "The number of clusters to be used in the analysis",
            "default": 15,
            "minimum": 1
        },
        "segmentation_algorithms": {
            "type": "string",
            "title": "Segmentation Algorithms",
            "description": "Which algorithms to run.",
            "enum": [
                "hmm",
                "kmeans"
            ],
            "multiple": true,
            "checkboxes": true,
            "default": [
                "hmm",
                "kmeans"
            ]
        },
        "overwrite_segmentation": {
            "type": "boolean",
            "title": "Overwrite Existing Segmentation",
            "description": "Recompute the motif labels.",
            "default": false
        },
        "overwrite_embeddings": {
            "type": "boolean",
            "title": "Overwrite Existing Embeddings",
            "description": "Recompute the latent embeddings.",
            "default": false
        }
    },
    "required": [
        "n_clusters"
    ]
}
